; Engine configuration file.
; Edit through the Godot editor (Project > Project Settings) where possible.

config_version=5

[application]

config/name="Midnighty Room"
config/description="A cozy late-night room to decorate, with a focus timer, to-do list and a mixable lofi soundscape."
config/version="0.2.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
boot_splash/bg_color=Color(0.07, 0.06, 0.13, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
AudioMixer="*res://scripts/autoload/audio_mixer.gd"
FocusTimer="*res://scripts/autoload/focus_timer.gd"
SteamService="*res://scripts/autoload/steam_service.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/per_pixel_transparency/allowed=true

[internationalization]

locale/translations=PackedStringArray("res://locale/strings.en.translation", "res://locale/strings.ms.translation")
locale/fallback="en"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.07, 0.06, 0.13, 1)
